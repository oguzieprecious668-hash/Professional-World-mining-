# Server-only configuration template. Do not commit credentials.
DATABASE_URL=postgresql://<local-user>:<local-password>@localhost:5432/<database>
OIDC_ISSUER=https://<identity-provider-issuer>
OIDC_CLIENT_ID=<server-side-client-id>
OIDC_CLIENT_SECRET=<in-secret-manager>
SESSION_SECRET=<generate-a-unique-random-value-in-secret-manager>
KYC_PROVIDER=<selected-provider-name>
KYC_API_KEY=<in-secret-manager>
KYC_WEBHOOK_SECRET=<in-secret-manager>
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000

# This template is not wired to a running service. Never use development values in production.
