# Web configuration (copy to .env.local; development template only)
AUTH_SECRET=generate-a-long-random-secret-for-local-development
AUTH_URL=http://localhost:3000
AUTH_OIDC_ISSUER=https://your-idp.example/issuer
AUTH_OIDC_CLIENT_ID=your-development-client-id
AUTH_OIDC_CLIENT_SECRET=your-development-client-secret
